POSTGRES_PASSWORD=datapilot-local
JWT_SECRET=replace-with-a-long-random-local-secret
SEED_ADMIN_EMAIL=admin@datapilot.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SUPERSET_SECRET_KEY=replace-with-a-long-random-superset-secret
SUPERSET_GUEST_TOKEN_SECRET=replace-with-a-separate-long-random-guest-token-secret
SUPERSET_EDITOR_SSO_SECRET=replace-with-a-separate-long-random-editor-sso-secret
SUPERSET_ADMIN_PASSWORD=ChangeMe123!
ENABLE_DEMO_DATA=false
TOOL_HTTP_ALLOWLIST=localhost,127.0.0.1,superset

# External query-tool gateway (/external/v1/*, /mcp) rate limiting — Redis-backed,
# fails open (no throttling) if REDIS_URL is unset or Redis is unreachable.
REDIS_URL=redis://localhost:6380/0
EXTERNAL_QUERY_TOOL_RATE_LIMIT_PER_MINUTE=60

# Caps simultaneous physical connections DataPilot will open against a single
# source-system connector at once (no per-driver connection pooling exists
# today — see app/connection_guard.py). Applies to every caller: internal SQL
# workspace, query-tool test/preview, and the external gateway alike.
CONNECTOR_MAX_CONCURRENT_CONNECTIONS=8

# SQLAlchemy connection pool — see infra/kubernetes/README.md "Connection pool
# sizing" before raising Kubernetes replica counts in production.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=3
DB_POOL_RECYCLE_SECONDS=1800

# Connector values can be JSON credentials or passwords paired with *_USERNAME.
SQLSERVER_CREDENTIALS=
ORACLE_CREDENTIALS=
TERADATA_CREDENTIALS=
BIGQUERY_CREDENTIALS=

# Configure enterprise integrations after the local file workflow is working.
COMPANY_MODEL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AgentGuard observability / AI governance. Keep prompt and response capture off
# unless the data handling policy explicitly permits it.
GOVERNANCE_ENABLED=false
# Comma-separated fan-out: agentguard, otlp, webhook. Use none to disable.
GOVERNANCE_PROVIDERS=agentguard
GOVERNANCE_SERVICE_NAME=datapilot-agent-os

# Standards-based OTLP/HTTP exporter. Use for Phoenix, Langfuse, or any OTLP collector.
GOVERNANCE_OTLP_ENDPOINT=
GOVERNANCE_OTLP_HEADERS_JSON={}

# Generic HTTPS JSON event sink. Headers and signing secret must be injected at runtime.
GOVERNANCE_WEBHOOK_URL=
GOVERNANCE_WEBHOOK_HEADERS_JSON={}
GOVERNANCE_WEBHOOK_SIGNING_SECRET=
AGENTGUARD_ENABLED=false
AGENTGUARD_SERVICE_NAME=datapilot-agent-os
AGENTGUARD_MODE=auto
AGENTGUARD_BASE_URL=
AGENTGUARD_PUBLIC_KEY=
AGENTGUARD_SECRET_KEY=
AGENTGUARD_CAPTURE_CONTENT=false
GOVERNANCE_GENERATION_CONTENT_MAX_CHARS=6000
# By default, non-LLM governance events follow the infra-span switch below.
# Set this to true only when you want AgentGuard to receive tool/connector/
# approval-style custom spans in addition to LLM generations.
AGENTGUARD_EXPORT_GOVERNANCE_EVENTS=
AGENTGUARD_INCLUDE_INFRA_SPANS=false
# Suppress repeated OTLP retry noise in local logs while keeping telemetry fail-open.
AGENTGUARD_SUPPRESS_EXPORT_LOGS=true
APP_ENV=development
OTEL_ENABLED=false
OTEL_SERVICE_NAME=datapilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=
PINGFEDERATE_ISSUER_URL=
PINGFEDERATE_CLIENT_ID=
PINGFEDERATE_CLIENT_SECRET=
# Keep conversation answers deterministic by default; enable for an extra narrative model call.
CONVERSATION_MODEL_SUMMARY_ENABLED=false
# Decision router (apps/api/app/decision_router.py): "local" (lexical scorer, <1 ms),
# "llm" (model routed to decision_routing) or "jev" (TypeSafe Jev via the
# OpenRouter Decisions API; uses OPENROUTER_API_KEY unless TYPESAFE_API_KEY is set).
# Jev may escalate approval risk but never lower it. Compare with POST /router/evaluate.
# auto = follow the model routed to decision_routing (Jev decision model or a text model); local when none.
DECISION_ROUTER_BACKEND=auto
TYPESAFE_API_URL=
TYPESAFE_API_KEY=
# Pinned model id; avoid the ~typesafe/jev-latest alias so verdicts do not drift silently.
TYPESAFE_MODEL=typesafe/jev-1.13
TYPESAFE_TIMEOUT_SECONDS=3.0
# Optional reviewed policy JSON (weights/thresholds/instructions/version), e.g.
# produced by an offline GEPA/DSPy optimisation over GET /router/decisions.
DECISION_POLICY_PATH=
# "llm" routes with the model assigned to the decision_routing purpose; compare
# backends first with POST /router/evaluate.
# OpenRouter (OpenAI-compatible). Seeded providers: Claude Sonnet 5 and DeepSeek V4.1 Flash.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3001
# SELECT-only login for user/model SQL (required when APP_ENV=production unless
# ALLOW_SHARED_QUERY_ENGINE=true). The API creates the role when it may.
STAGING_DATABASE_URL=
STAGING_READER_ROLE=datapilot_reader
STAGING_READER_PASSWORD=
ALLOW_SHARED_QUERY_ENGINE=false
# Versioned migrations; set false where a migration job runs (python -m app.migrate).
RUN_MIGRATIONS_ON_STARTUP=true
SQL_CACHE_TTL_HOURS=24
# Failed sign-ins allowed per email+IP per 5 minutes (Redis-backed, local fallback).
LOGIN_FAILURES_PER_WINDOW=10
# Optional comma-separated allowlist (supports PREFIX*) for env: secret references.
SECRET_REFERENCE_ALLOWLIST=
NOTEBOOK_PYTHON_TIMEOUT_SECONDS=5
NOTEBOOK_PYTHON_ISOLATION=process
# Multi-model SQL vote: cascade (default) asks sql_candidate_3 only when the first two disagree; always | off.
SQL_VOTE_MODE=cascade
# DDL is advice: index suggestions come from queries slower than SLOW_QUERY_MS and are saved for DBAs.
SLOW_QUERY_MS=500
# Only set true to let approved local index suggestions execute (default: never executed).
ALLOW_DDL_EXECUTION=false
