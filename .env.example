POSTGRES_PASSWORD=datapilot-local
JWT_SECRET=replace-with-a-long-random-local-secret
SEED_ADMIN_EMAIL=admin@datapilot.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SUPERSET_SECRET_KEY=replace-with-a-long-random-superset-secret
SUPERSET_GUEST_TOKEN_SECRET=replace-with-a-separate-long-random-guest-token-secret
SUPERSET_EDITOR_SSO_SECRET=replace-with-a-separate-long-random-editor-sso-secret
SUPERSET_ADMIN_PASSWORD=ChangeMe123!
ENABLE_DEMO_DATA=false
TOOL_HTTP_ALLOWLIST=localhost,127.0.0.1,superset

# Connector values can be JSON credentials or passwords paired with *_USERNAME.
SQLSERVER_CREDENTIALS=
ORACLE_CREDENTIALS=
TERADATA_CREDENTIALS=
BIGQUERY_CREDENTIALS=

# Configure enterprise integrations after the local file workflow is working.
COMPANY_MODEL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AgentGuard observability / AI governance. Keep prompt and response capture off
# unless the data handling policy explicitly permits it.
GOVERNANCE_ENABLED=false
# Comma-separated fan-out: agentguard, otlp, webhook. Use none to disable.
GOVERNANCE_PROVIDERS=agentguard
GOVERNANCE_SERVICE_NAME=datapilot-agent-os

# Standards-based OTLP/HTTP exporter. Use for Phoenix, Langfuse, or any OTLP collector.
GOVERNANCE_OTLP_ENDPOINT=
GOVERNANCE_OTLP_HEADERS_JSON={}

# Generic HTTPS JSON event sink. Headers and signing secret must be injected at runtime.
GOVERNANCE_WEBHOOK_URL=
GOVERNANCE_WEBHOOK_HEADERS_JSON={}
GOVERNANCE_WEBHOOK_SIGNING_SECRET=
AGENTGUARD_ENABLED=false
AGENTGUARD_SERVICE_NAME=datapilot-agent-os
AGENTGUARD_MODE=auto
AGENTGUARD_BASE_URL=
AGENTGUARD_PUBLIC_KEY=
AGENTGUARD_SECRET_KEY=
AGENTGUARD_CAPTURE_CONTENT=false
GOVERNANCE_GENERATION_CONTENT_MAX_CHARS=6000
# By default, non-LLM governance events follow the infra-span switch below.
# Set this to true only when you want AgentGuard to receive tool/connector/
# approval-style custom spans in addition to LLM generations.
AGENTGUARD_EXPORT_GOVERNANCE_EVENTS=
AGENTGUARD_INCLUDE_INFRA_SPANS=false
# Suppress repeated OTLP retry noise in local logs while keeping telemetry fail-open.
AGENTGUARD_SUPPRESS_EXPORT_LOGS=true
APP_ENV=development
OTEL_ENABLED=false
OTEL_SERVICE_NAME=datapilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=
PINGFEDERATE_ISSUER_URL=
PINGFEDERATE_CLIENT_ID=
PINGFEDERATE_CLIENT_SECRET=
# Keep conversation answers deterministic by default; enable for an extra narrative model call.
CONVERSATION_MODEL_SUMMARY_ENABLED=false
